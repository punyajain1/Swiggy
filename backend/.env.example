# Neon pooled connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection string (no "-pooler"). Used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

GROQ_API_KEY="gsk_your_key_here"
# Groq retired llama-3.3-70b-versatile on 2026-08-16; gpt-oss-120b is the recommended replacement.
GROQ_MODEL="openai/gpt-oss-120b"

# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENC_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"

PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"

# Where Swiggy sends the user after login. Must be http://localhost[...] for local dev.
# If Swiggy rejects the port, set this to http://localhost/callback and run `npm run callback-proxy`.
SWIGGY_REDIRECT_URL="http://localhost:4000/auth/callback"

# Swiggy MCP servers. These are the defaults; set them only to point somewhere else.
# SWIGGY_FOOD_URL="https://mcp.swiggy.com/food"
# SWIGGY_IM_URL="https://mcp.swiggy.com/im"
# SWIGGY_DINEOUT_URL="https://mcp.swiggy.com/dineout"   # SideQuest dinners (read-only)
# SWIGGY_SCENES_URL="https://mcp.swiggy.com/scenes"     # SideQuest events (read-only)
